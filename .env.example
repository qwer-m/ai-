DASHSCOPE_API_KEY=your_api_key_here
# Agent 平台单次 Run 硬额度；调用方只能申请更低值。
AGENT_RUN_MAX_REQUESTS=80
AGENT_RUN_MAX_INPUT_TOKENS=300000
AGENT_RUN_MAX_OUTPUT_TOKENS=120000
AGENT_RUN_MAX_TOTAL_TOKENS=400000
# 映射节点因上游压力降载后，连续成功多少次恢复一级并发
AGENT_MAP_CONCURRENCY_RECOVERY_SUCCESSES=6
AGENT_MAP_MIN_CONCURRENCY=2
AGENT_MAP_CONCURRENCY_PRESSURE_FAILURES=2
AGENT_MAP_FIRST_ATTEMPT_TIMEOUT_SECONDS=120
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_PORT=3306
DB_NAME=ai_test_platform
DATABASE_URL=
SECRET_KEY=change_this_in_production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
REDIS_HOST=localhost
REDIS_PORT=6379
# 每个用户、项目和工作流保留的终态 Agent Run 数量
AGENT_RUN_HISTORY_LIMIT=1
