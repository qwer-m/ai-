fidence": "high", "source_type": "confirmed_requirement", "blocking": true, "non_blocking_reason": "", "covered": true, "coverage_types": ["boundary", "happy"], "missing_types": []}, {"rule_id": "RULE-021", "rule_text": "五、后续流程•动画播放 2-3 秒后,底部渐显\"下一步\"按钮•点击后进入\"讲知识 & 错题\"步骤•若还有未完成的日清,左侧导航第六步显示待完成提示•左侧导航自动将\"出⻔测\"标记为完成,\"讲知识& 错题\"高亮为当前", "biz_key": "unknown", "rule_level": "hard", "confidence": "high", "source_type": "confirmed_requirement", "blocking": true, "non_blocking_reason": "", "covered": true, "coverage_types": ["boundary", "exception", "happy", "risk"], "missing_types": []}, {"rule_id": "RULE-022", "rule_text": "六、极限情况•动画播放时退出或刷新:直接显示静态结果页,金币已正常发放•重复刷新结果页:金币只发放一次,幂等处理•多个模块连续完成:每个模块独立触发庆祝,动画排队播放,不堆积课后报告+习题集错题流向•进入学生端错题本,包括推荐的相似题•进入督导端习题集全部错题•进入课后报告错题打包", "biz_key": "unknown", "rule_level": "hard", "confidence": "high", "source_type": "confirmed_requirement", "blocking": true, "non_blocking_reason": "", "covered": true, "coverage_types": ["boundary", "happy"], "missing_types": []}], "coverage_rate": 1.0, "missing_types": {"boundary": [], "exception": []}, "kind": "coverage_check", "request_id": "f242c53c31ca4995aef67654b53ea417", "project_id": 8, "multi_pass": true, "generation_mode": "multi_pass"}

