                    "steps": ["1. 选择非图片格式文件", "2. 点击上传", "3. 查看页面反馈"],
                    "test_input": "docx 或 pdf 文件",
                    "expected_result": "系统拦截上传并提示仅支持图片格式，上传区不新增缩略图且去批改按钮状态不受影响",
                    "priority": "P1",
                },
                {
                    "id": "TC-FULL-SUP-002",
                    "description": "上传图片数量超过上限时提示并保留已上传图片",
                    "test_module": "作文批改",
                    "preconditions": ["学生用户已登录且上传区已有允许数量上限的图片"],
                    "steps": ["1. 继续选择额外作文图片", "2. 查看上传结果"],
                    "test_input": "超过数量上限的作文图片",
                    "expected_result": "系统提示图片数量超过上限，额外图片不加入上传区，已上传图片顺序和缩略图保持不变",
                    "priority": "P1",
                },
                {
                    "id": "TC-FULL-SUP-003",
                    "description": "OCR 识别失败时批改任务不进入成功态",
                    "test_module": "作文批改",
                    "preconditions": ["学生用户已上传无法识别文字的作文图片"],
                    "steps": ["1. 点击去批改", "2. 等待 OCR 返回失败", "3. 查看批改任务状态"],
                    "test_input": "模糊或无文字图片",
                    "expected_result": "系统提示识别失败并允许重新上传或重试，不生成批改结果且作品不进入可投稿状态",
                    "priority": "P1",
                },
                {
