        "\u5f85\u8ba8\u8bba",
        "\u6682\u4e0d\u652f\u6301",
        "to be confirmed",
        "need discussion",
        "optional this phase",
        "model not supported",
    )

    _P0_GROUP_TOKENS: dict[str, tuple[str, ...]] = {
