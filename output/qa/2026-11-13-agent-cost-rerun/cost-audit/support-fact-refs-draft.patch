+def planning_support_fact_ref_catalog(facts: list[dict[str, Any]]) -> dict[int, str]:
+    """当前请求的引用目录只由完整稳定ID排序生成，不依赖字典或事实读取顺序。"""
+    if not isinstance(facts, list) or not facts or any(not isinstance(fact, dict) for fact in facts):
